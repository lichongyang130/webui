# ── User auth ────────────────────────────────────────────────────────────────
# HMAC secret used to sign user session cookies (required in production)
AUTH_SECRET=

# Google OAuth — create credentials at
# https://console.cloud.google.com/apis/credentials  (type: Web application)
# Authorized redirect URI: <your-origin>/api/auth/oauth/google/callback
#   e.g. http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — create an OAuth App at
# https://github.com/settings/developers  →  New OAuth App
# Authorization callback URL: <your-origin>/api/auth/oauth/github/callback
#   e.g. http://localhost:3000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# When a provider's keys are absent the button still works in a clearly
# labelled DEMO mode (signs you in as a demo account) — handy for previews.
